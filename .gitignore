# Logs e artefatos locais da interface/testes
temp/
mcp_*.json

.streamlit-local.log
.streamlit-local.err.log
*.zip
/artifacts/requirements-dev-resolved.txt

# Mantém a estrutura vazia
!/config/custom/.gitkeep
!/data/raw/.gitkeep
!/data/manifests/.gitkeep
!/data/db/.gitkeep
!/data/processed/.gitkeep
!/data/quarantine/.gitkeep
!/data/control/.gitkeep
!/data/fulltext/.gitkeep
