# Ambientes e segredos
.venv*/
.env
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editores e sistema
.vscode/
.idea/
.agents/
.DS_Store
Thumbs.db

# Dados e resultados gerados
/config/custom/*
/data/raw/*
/data/manifests/*
/data/db/*
/data/processed/*
/data/quarantine/*
/data/control/*
/exports/zotero/*
/exports/asreview/*
/exports/bibliometrix/*
/reports/*

# Mantém a estrutura vazia
!/config/custom/.gitkeep
!/data/raw/.gitkeep
!/data/manifests/.gitkeep
!/data/db/.gitkeep
!/data/processed/.gitkeep
!/data/quarantine/.gitkeep
!/data/control/.gitkeep
!/exports/zotero/.gitkeep
!/exports/asreview/.gitkeep
!/exports/bibliometrix/.gitkeep
!/reports/.gitkeep
