# Ambientes e segredos
.venv*/
.env
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editores e sistema
.vscode/
.idea/
.agents/
.DS_Store
Thumbs.db
*.code-workspace

# Dados e resultados gerados
/config/custom/*
/data/raw/*
/data/manifests/*
/data/db/*
/data/processed/*
/data/quarantine/*
/data/control/*
/data/fulltext/*
/exports/zotero/*
